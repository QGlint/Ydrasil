import os
import sys

BSP_ROOT = os.path.abspath(os.getcwd())
RTT_APP = os.getenv('RTT_APP', 'rtthread-coremark')
RTT_VERSION = os.getenv('RTT_VERSION', '3.1.5')
RTT_RUNTIME_DIRS = {
    '3.1.5': 'rt-thread-nano-3.1.5',
    '5.2.2': 'rt-thread-5.2.2',
}
if RTT_VERSION not in RTT_RUNTIME_DIRS:
    raise RuntimeError(
        'Unsupported RTT_VERSION=%s; choose one of: %s' %
        (RTT_VERSION, ', '.join(sorted(RTT_RUNTIME_DIRS))))

RTT_ROOT = os.path.abspath(os.path.join(
    BSP_ROOT, '..', '..', RTT_RUNTIME_DIRS[RTT_VERSION]))
# Nano intentionally has no build system. Reuse only the established SCons
# helpers; all linked runtime sources still come from RTT_ROOT above.
RTT_TOOLS_ROOT = os.path.abspath(os.path.join(
    BSP_ROOT, '..', '..', 'rt-thread-5.2.2', 'tools'))

sys.path.insert(0, RTT_TOOLS_ROOT)

from building import *
from SCons import SConsign

os.makedirs(rtconfig.OUTPUT_DIR, exist_ok=True)
os.environ.setdefault('RTT_BUILD_DIR', os.path.join(rtconfig.OUTPUT_DIR, 'objects'))
SConsign.File(os.path.join(rtconfig.OUTPUT_DIR, '.sconsign.dblite'))

# Redirect the RT-Thread build helpers' fixed variant directories so all
# intermediates stay with the selected application output.
import inspect
import building as _building

# building.py parses rtconfig.h independently of the compiler command line.
# Seed the same selection macros that rtconfig.py passes to GCC.
_preprocessor_defines = {}
if RTT_VERSION == '5.2.2':
    _preprocessor_defines['RTT_LEGACY_522_BUILD'] = 1
if RTT_APP == 'rtthread-utest':
    _preprocessor_defines['RTT_UTEST_BUILD'] = 1

if _preprocessor_defines:
    _create_preprocessor_instance = _building.create_preprocessor_instance

    def _create_profile_preprocessor():
        preprocessor = _create_preprocessor_instance()
        preprocessor.cpp_namespace.update(_preprocessor_defines)
        return preprocessor

    _building.create_preprocessor_instance = _create_profile_preprocessor

_variant_root = os.path.abspath(os.environ['RTT_BUILD_DIR'])
_sconscript = _building.SConscript


def _redirect_variant_dir(script, *args, **kwargs):
    variant_dir = kwargs.get('variant_dir')
    if variant_dir == 'build':
        kwargs['variant_dir'] = os.path.join(_variant_root, 'bsp')
    elif variant_dir == 'build/kernel':
        kwargs['variant_dir'] = os.path.join(_variant_root, 'kernel')
    elif isinstance(variant_dir, str) and variant_dir.startswith('build/kernel/'):
        suffix = variant_dir[len('build/kernel/'):]
        kwargs['variant_dir'] = os.path.join(_variant_root, 'kernel', suffix)
    if kwargs.get('exports') == 'remove_components':
        caller = inspect.currentframe().f_back
        kwargs['exports'] = {
            'remove_components': caller.f_locals.get('remove_components', [])
        }
    return _sconscript(script, *args, **kwargs)


_building.SConscript = _redirect_variant_dir
TARGET = os.path.relpath(rtconfig.TARGET, BSP_ROOT)

DefaultEnvironment(tools=[])
env = Environment(AS=rtconfig.AS, ASFLAGS=rtconfig.AFLAGS,
                  CC=rtconfig.CC, CFLAGS=rtconfig.CFLAGS,
                  CXX=rtconfig.CXX, CXXFLAGS=rtconfig.CXXFLAGS,
                  AR=rtconfig.AR, ARFLAGS='-rc',
                  LINK=rtconfig.LINK, LINKFLAGS=rtconfig.LFLAGS)
env.PrependENVPath('PATH', rtconfig.EXEC_PATH)

Export('RTT_ROOT')
Export('RTT_VERSION')
Export('rtconfig')

objects = PrepareBuilding(env, RTT_ROOT)
DoBuilding(TARGET, objects)
Default(TARGET)
env.Depends(TARGET, rtconfig.LINK_SCRIPT)
env.Clean(TARGET, [
    rtconfig.DUMP, rtconfig.ITCM_BIN, rtconfig.DTCM_BIN,
    rtconfig.ITCM, rtconfig.DTCM, rtconfig.MAP
])

menu "Ydrasil BSP"

config SOC_YDRASIL
    bool
    default y
    select ARCH_RISCV32

config BSP_USING_SIM_CONSOLE
    bool "Use the 0x80200060 simulation output register"
    default n
    help
        This is the only console endpoint currently implemented in the FPGA
        integration. It is write-only and therefore cannot provide FinSH input.

config BSP_USING_UART0
    bool "Enable UART0 console"
    default y
    help
        Use UART0 at 0x40002000 as the console and FinSH input device.

config BSP_USING_MTIME_TICK
    bool "Enable CLINT machine-timer tick"
    default y
    help
        Enable only after MTIME, MTIMECMP and machine-timer interrupt delivery
        are implemented and verified in hardware.

config BSP_USING_PLIC
    bool "Enable PLIC external interrupts"
    default y
    help
        Enable only after the PLIC and machine-external interrupt path are
        connected in hardware.

config BSP_USING_COREMARK
    bool "Build CoreMark as the RT-Thread main application"
    default n
    help
        This option is selected by the BSP Makefile benchmark targets. CoreMark
        itself is an integer workload and does not require the FPU.

endmenu

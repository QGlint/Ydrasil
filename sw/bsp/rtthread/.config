# RT-Thread kernel
CONFIG_RT_NAME_MAX=16
CONFIG_RT_USING_NANO=y
CONFIG_RT_CPUS_NR=1
CONFIG_RT_ALIGN_SIZE=4
CONFIG_RT_THREAD_PRIORITY_32=y
CONFIG_RT_THREAD_PRIORITY_MAX=32
CONFIG_RT_TICK_PER_SECOND=1000
CONFIG_IDLE_THREAD_STACK_SIZE=256
# CONFIG_RT_USING_TIMER_SOFT is not set
# CONFIG_RT_USING_DEBUG is not set
# CONFIG_RT_USING_SEMAPHORE is not set
# CONFIG_RT_USING_MUTEX is not set
# CONFIG_RT_USING_EVENT is not set
# CONFIG_RT_USING_MAILBOX is not set
# CONFIG_RT_USING_MESSAGEQUEUE is not set
# CONFIG_RT_USING_MEMPOOL is not set
CONFIG_RT_USING_NOHEAP=y
# CONFIG_RT_USING_HEAP is not set
# CONFIG_RT_USING_DEVICE is not set
CONFIG_RT_USING_CONSOLE=y
CONFIG_RT_CONSOLEBUF_SIZE=128
# CONFIG_RT_USING_CONSOLE_OUTPUT_CTL is not set
CONFIG_RT_VER_NUM=0x50300
CONFIG_RT_BACKTRACE_LEVEL_MAX_NR=8

# Architecture and application entry
CONFIG_ARCH_RISCV=y
# CONFIG_ARCH_RISCV_FPU is not set
# CONFIG_RT_USING_COMPONENTS_INIT is not set
CONFIG_RT_USING_USER_MAIN=y
CONFIG_RT_MAIN_THREAD_STACK_SIZE=3072
CONFIG_RT_MAIN_THREAD_PRIORITY=10
